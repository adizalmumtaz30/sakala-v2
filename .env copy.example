NEXT_PUBLIC_APP_ENV=development

# Supabase Dashboard → Connect → App Frameworks, atau Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Hanya diisi kalau butuh operasi server yang melewati RLS (jangan pernah
# taruh ini di NEXT_PUBLIC_*, dan jangan commit ke git)
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_IMPORT_MAX_ROWS=2000
